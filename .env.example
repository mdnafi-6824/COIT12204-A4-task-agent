# Copy this file to .env and put your real key in .env (never in this file).
# Pick one provider. openai is the default.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# Or use Anthropic instead:
 LLM_PROVIDER=anthropic
 ANTHROPIC_API_KEY=sk-ant-your-key
 ANTHROPIC_MODEL=claude-sonnet-4-6

PROMPT_VERSION=v3

# Two agent system (Assessment 4). These are the defaults.
# REVIEWER_USE_LLM=true
# MAX_REVISIONS=2
# MAX_STEPS=10
# AGENT_TIMEOUT_SECONDS=45
